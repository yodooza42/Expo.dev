modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EAS Build v72 prod"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EAS Build v73 prod"

[[workflows.workflow]]
name = "EAS Build v72 prod"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/artifacts/yoann2 && export EXPO_TOKEN=IoFAF-TezmfedsNBuYegjJM_ogPj4FPmIZD41LfM && GIT_OPTIONAL_LOCKS=0 /home/runner/workspace/.config/npm/node_global/bin/eas build --platform android --profile production --non-interactive 2>&1"

[[workflows.workflow]]
name = "EAS Build v73 prod"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/artifacts/yoann2 && export EXPO_TOKEN=IoFAF-TezmfedsNBuYegjJM_ogPj4FPmIZD41LfM && GIT_OPTIONAL_LOCKS=0 /home/runner/workspace/.config/npm/node_global/bin/eas build --platform android --profile production --non-interactive 2>&1"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 24240
externalPort = 3000

[[ports]]
localPort = 24241
externalPort = 3001

[userenv]

[userenv.shared]

[nix]
