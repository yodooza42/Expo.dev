{
  "expo": {
    "name": "Yoann2.0",
    "slug": "yoann2",
    "owner": "yoann42",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yoann2",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#121212",
      "package": "com.yoann2.app",
      "versionCode": 4,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Yoann2.0 accède à votre galerie pour les photos de projets.",
          "cameraPermission": "Yoann2.0 accède à la caméra pour prendre des photos de projets."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodoWidget",
              "label": "Yoann2.0 — À faire",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "description": "Tâches et rendez-vous du jour",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "04956cab-7ba6-4daa-b04a-2b498d0cc992"
      }
    }
  }
}
