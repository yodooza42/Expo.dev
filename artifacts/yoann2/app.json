{
  "expo": {
    "name": "Yoann2.0",
    "slug": "yoann2",
    "owner": "stpyoann48fbeocbekc",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yoann2",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#121212",
      "package": "com.yoann2.app",
      "versionCode": 37,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yoann2.0 accède à votre position pour afficher votre tracé du jour.",
          "locationAlwaysAndWhenInUsePermission": "Yoann2.0 enregistre votre position en arrière-plan pour le journal de déplacements.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FFC107",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yoann2.0 accède à votre galerie pour les photos de projets.",
          "cameraPermission": "Yoann2.0 accède à la caméra pour prendre des photos de projets."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodoWidget",
              "label": "Yoann2.0 — À faire",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 5,
              "resizeMode": "vertical",
              "minResizeHeight": "110dp",
              "description": "Tâches et rendez-vous du jour",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "13c352b8-8396-4e9a-a06f-a57aa8f801bc"
      },
      "router": {
        "origin": "https://replit.com/"
      }
    }
  }
}
